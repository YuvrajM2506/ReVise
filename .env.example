# =====================================================================
# ReVise Environment Configuration
# =====================================================================

# Groq API Key (Fast LPU Inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Primary model: openai/gpt-oss-120b or llama-3.3-70b-versatile or qwen/qwen-2.5-32b
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen-2.5-32b

# Hindsight Cloud API Key (Long-term Engineering Memory)
# Get your key at: https://hindsight.vectorize.io/ or https://ui.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_your_hindsight_api_key_here

# Hindsight Project / Bank Namespace (Default: acme-platform)
HINDSIGHT_BANK_ID=acme-platform
HINDSIGHT_PROJECT_ID=acme-platform

# Hindsight Cloud Base API URL (Default: https://api.hindsight.vectorize.io)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
